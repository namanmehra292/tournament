# Postgres connection string (Render Postgres "Internal Database URL" in prod)
DATABASE_URL="postgresql://user:password@localhost:5432/badminton"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (console.cloud.google.com -> OAuth client credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment gateway (placeholder — fill in when you wire Razorpay/Stripe)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
