// =============================================================
// Badminton Tournament — Prisma schema
// Postgres. Ownership is enforced at the query layer (lib/auth.ts)
// since Prisma has no native RLS — every registration read/write
// is scoped by userId, mirroring what Postgres RLS would do.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  MENS_SINGLES
  WOMENS_SINGLES
  MENS_DOUBLES
  WOMENS_DOUBLES
  MIXED_DOUBLES
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  // null for OAuth-only accounts
  passwordHash  String?
  name          String?
  image         String?
  role          Role           @default(USER)
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
  loginAttempts LoginAttempt[]

  @@map("users")
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Tracks failed logins per email+IP for rate limiting / lockout
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// One row per tournament entry (a pair shares one Registration for doubles)
model Registration {
  id          String             @id @default(cuid())
  userId      String
  category    Category
  status      RegistrationStatus @default(PENDING_PAYMENT)
  feeAmount   Int                // in smallest currency unit (paise)
  currency    String             @default("INR")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  players Player[]
  payment Payment?

  @@index([userId])
  @@map("registrations")
}

model Player {
  id             String       @id @default(cuid())
  registrationId String
  fullName       String
  age            Int
  contactEmail   String
  contactPhone   String
  // true for the second player in a doubles pair
  isPartner      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("players")
}

model Payment {
  id              String        @id @default(cuid())
  registrationId  String        @unique
  provider        String        @default("placeholder")
  providerOrderId String?
  providerPayId   String?
  amount          Int
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("payments")
}
